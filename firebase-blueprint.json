{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "object" },
        "lastActiveAt": { "type": "object" },
        "subscriptionTier": { "type": "string", "enum": ["free", "sheng"] },
        "subscriptionType": { "type": "string" },
        "subscriptionExpiry": { "type": "number" },
        "unlockedInsightsCount": { "type": "number" },
        "totalReadings": { "type": "number" },
        "firstReadingAt": { "type": "object" },
        "lastReadingAt": { "type": "object" },
        "localMigrationCompleted": { "type": "boolean" }
      },
      "required": ["email", "createdAt", "subscriptionTier"]
    },
    "Reading": {
      "title": "Reading",
      "description": "Individual divination record",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "hexagramName": { "type": "string" },
        "hexagramNumber": { "type": "number" },
        "changingLines": { "type": "array", "items": { "type": "number" } },
        "report": { "type": "string" },
        "coreReflection": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "sentiment": { "type": "string" },
        "questionType": { "type": "string" },
        "primaryTheme": { "type": "string" },
        "createdAt": { "type": "object" },
        "isStarred": { "type": "boolean" },
        "userNote": { "type": "string" },
        "dialogueCount": { "type": "number" },
        "source": { "type": "string" }
      },
      "required": ["question", "hexagramName", "createdAt", "source"]
    },
    "InsightReport": {
      "title": "Insight Report",
      "description": "Historical insights generated for milestones",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "structuredData": { "type": "object" },
        "relatedReadingIds": { "type": "array", "items": { "type": "string" } },
        "isPaid": { "type": "boolean" },
        "createdAt": { "type": "object" }
      },
      "required": ["type", "title", "content", "isPaid", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Payment order record",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "failed", "cancelled"] },
        "provider": { "type": "string" },
        "createdAt": { "type": "object" },
        "paidAt": { "type": "object" }
      },
      "required": ["productId", "amount", "status", "createdAt"]
    },
    "OTPVerification": {
      "title": "OTP Verification",
      "description": "Temporary storage for email verification codes",
      "type": "object",
      "properties": {
        "otp": { "type": "string" },
        "expiresAt": { "type": "number" },
        "attempts": { "type": "number" }
      },
      "required": ["otp", "expiresAt", "attempts"]
    }
  },
  "firestore": {
    "/otp_verifications/{email}": {
      "schema": "OTPVerification",
      "description": "Temporary OTP codes"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/readings/{readingId}": {
      "schema": "Reading",
      "description": "Individual divination records"
    },
    "/users/{userId}/insightReports/{reportId}": {
      "schema": "InsightReport",
      "description": "Milestone based historical insights"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "Order",
      "description": "Payment order records"
    }
  }
}
