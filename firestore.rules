rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(userId)
        && (
          // Allow updating lastActiveAt, localMigrationCompleted, etc.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt', 'localMigrationCompleted', 'totalReadings', 'lastReadingAt', 'subscriptionType', 'subscriptionExpiry', 'subscriptionTier', 'unlockedInsightsCount'])
        );
    }

    // Order Rules
    match /users/{userId}/orders/{orderId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Reading Rules
    match /users/{userId}/readings/{readingId} {
      allow read, write: if isOwner(userId);
      
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Insight Reports Rules
    match /users/{userId}/insightReports/{reportId} {
      allow read, write: if isOwner(userId);
    }
  }
}
